ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Waffle Iron kernel-v2 exact B-Rep export'),'2;1');
FILE_NAME('sphere.step','',(''),(''),'Waffle Iron kernel-v2','Waffle Iron','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1 = APPLICATION_CONTEXT('core data for automotive mechanical design processes');
#2 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2010,#1);
#3 = PRODUCT_CONTEXT('',#1,'mechanical');
#4 = PRODUCT('sphere','sphere','',(#3));
#5 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#4));
#6 = PRODUCT_DEFINITION_FORMATION('','',#4);
#7 = PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#8 = PRODUCT_DEFINITION('design','',#6,#7);
#9 = PRODUCT_DEFINITION_SHAPE('','',#8);
#10 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(9.9999999999999995E-7),#10,'distance_accuracy_value','confusion accuracy');
#14 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
#15 = CARTESIAN_POINT('',(0.,0.,0.));
#16 = DIRECTION('',(0.,0.,1.));
#17 = DIRECTION('',(1.,0.,0.));
#18 = AXIS2_PLACEMENT_3D('',#15,#16,#17);
#19 = CARTESIAN_POINT('',(0.,0.,0.));
#20 = DIRECTION('',(0.,0.,1.));
#21 = DIRECTION('',(1.,0.,0.));
#22 = AXIS2_PLACEMENT_3D('',#19,#20,#21);
#23 = SPHERICAL_SURFACE('',#22,5.);
#24 = CARTESIAN_POINT('',(0.,0.,-5.));
#25 = VERTEX_POINT('',#24);
#26 = CARTESIAN_POINT('',(0.,0.,5.));
#27 = VERTEX_POINT('',#26);
#28 = CARTESIAN_POINT('',(0.,0.,0.));
#29 = DIRECTION('',(0.,-1.,0.));
#30 = DIRECTION('',(0.,0.,-1.));
#31 = AXIS2_PLACEMENT_3D('',#28,#29,#30);
#32 = CIRCLE('',#31,5.);
#33 = EDGE_CURVE('',#25,#27,#32,.T.);
#34 = ORIENTED_EDGE('',*,*,#33,.T.);
#35 = ORIENTED_EDGE('',*,*,#33,.F.);
#36 = EDGE_LOOP('',(#34,#35));
#37 = FACE_OUTER_BOUND('',#36,.T.);
#38 = ADVANCED_FACE('',(#37),#23,.T.);
#39 = CLOSED_SHELL('',(#38));
#40 = MANIFOLD_SOLID_BREP('sphere',#39);
#41 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#18,#40),#14);
#42 = SHAPE_DEFINITION_REPRESENTATION(#9,#41);
ENDSEC;
END-ISO-10303-21;
