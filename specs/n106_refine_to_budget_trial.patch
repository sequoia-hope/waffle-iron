+    F: Fn(&[Point2]) -> Result<(Vec<[u32; 3]>, Vec<Point3>), ConstructError>,
+{
+    let fail = |new_max| ConstructError::ChordDegradation {
+        patch,
+        old_max,
+        new_max,
+    };
+    // Start from a seedless attempt so the offender set is this patch's own.
+    let mut seeds: Vec<Point2> = Vec::new();
+    let mut last_max = match run_attempt(&seeds) {
+        Ok(out) => return Ok(out),
+        Err(ConstructError::ChordDegradation { new_max, .. }) => new_max,
+        Err(e) => return Err(e),
+    };
+    for _ in 0..D_OF_T_REFINE_MAX_ROUNDS {
+        let fresh: Vec<Point2> = offenders
+            .borrow()
+            .iter()
+            .copied()
+            .filter(|c| c.x().is_finite() && c.y().is_finite() && !seeds.contains(c))
+            .collect();
+        if fresh.is_empty() {
+            return Err(fail(last_max));
+        }
+        seeds.extend(fresh);
+        match run_attempt(&seeds) {
+            Ok(out) => return Ok(out),
+            Err(ConstructError::ChordDegradation { new_max, .. }) => last_max = new_max,
+            Err(e) => return Err(e),
+        }
+    }
+    Err(fail(last_max))
